{
  "name": "@obinexusltd/ruby-polycall",
  "version": "1.1.0",
  "description": "Ruby Fiddle binding for the Polycall binding ABI v1 (libpolycall >= 1.1.0): config validation, RPC calls and peer nodes",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./examples/*": "./examples/*",
    "./tests/*": "./tests/*",
    "./config": "./ruby-polycallrc",
    "./manifest": "./polycall-binding.json",
    "./gemspec": "./ruby-polycall.gemspec"
  },
  "files": [
    "index.js",
    "ruby-polycall.gemspec",
    "lib/",
    "src/",
    "dist/",
    "examples/",
    "tests/",
    "ruby-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "lib",
    "src": "src",
    "dist": "dist",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/package.test.js && sh tests/run-real-core.sh",
    "test:package": "node tests/package.test.js",
    "test:ruby": "sh tests/run-real-core.sh --verbose",
    "prepack": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/ruby-polycall.git"
  },
  "keywords": [
    "polycall",
    "libpolycall",
    "ruby",
    "fiddle",
    "ffi",
    "peer-to-peer"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/ruby-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/ruby-polycall#readme"
}
